# URL de Directus vue depuis le navigateur de l'utilisateur.
VITE_DIRECTUS_URL=http://localhost:8055

# true = données de démonstration locales (conseillé pour le premier lancement)
# false = lecture réelle de la collection PROJETS dans Directus
VITE_USE_MOCK_DATA=true

# Laisser false tant que les permissions et le workflow sécurisé ne sont pas configurés.
VITE_ENABLE_REQUESTS=false
