# Configuration d'exemple - ne jamais mettre de vrais secrets dans GitHub.
POSTGRES_DB=cri_projets
POSTGRES_USER=cri_user
POSTGRES_PASSWORD=CHANGE_ME
DIRECTUS_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# URLs locales. En production, remplacer par les vraies URLs HTTPS.
DIRECTUS_PUBLIC_URL=http://localhost:8055
FRONTEND_PUBLIC_URL=http://localhost:5173

# E-mail : les valeurs ci-dessous utilisent Mailpit en local.
# Pour un SMTP réel, remplacer seulement les valeurs dans .env.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply@cri.local
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_IGNORE_TLS=true
CRI_CONTACT_EMAIL=contact@cri.local

# Durée de validité du lien sécurisé Business Plan, en heures.
BUSINESS_PLAN_LINK_TTL_HOURS=168

# Authentification de l'espace investisseur.
CORS_CREDENTIALS=true
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
INVESTOR_ROLE_NAME=Investisseur

# Vérification e-mail et récupération de mot de passe investisseur.
INVESTOR_EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_URL_ALLOW_LIST=http://localhost:5173

# Protection contre les rafales d'e-mails.
RATE_LIMITER_EMAIL_ENABLED=true
RATE_LIMITER_EMAIL_POINTS=20
RATE_LIMITER_EMAIL_DURATION=60
